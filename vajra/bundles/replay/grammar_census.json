    "rules": [
      {
        "cells_matched": 24,
        "cells_uniquely_blocked": 6,
        "id": "FC-01",
        "match": {
          "depth": 1,
          "evasion": "graph-camouflage"
        },
        "nominal_cardinality": 24,
        "reason": "Camouflaging a subgraph requires at least two hops to shape. A single-stage kill chain has no counterparty structure to make look like a family or a gig worker."
      },
      {
        "cells_matched": 32,
        "cells_uniquely_blocked": 12,
        "id": "FC-02",
        "match": {
          "depth": 1,
          "rail_class": "card-post-auth"
        },
        "nominal_cardinality": 32,
        "reason": "Every presentment, chargeback and representment resolves to an antecedent authorisation -- that is an F1 invariant that fails the build, not a preference. So the clearing/dispute class is two-stage at minimum by construction."
      },
      {
        "cells_matched": 32,
        "cells_uniquely_blocked": 12,
        "id": "FC-03",
        "match": {
          "depth": 1,
          "rail_class": "card-token"
        },
        "nominal_cardinality": 32,
        "reason": "The token class is provisioning FOLLOWED BY first use. Provisioning-to-first-use latency is the load-bearing observable for the whole class, and it does not exist inside a single stage."
      },
      {
        "cells_matched": 32,
        "cells_uniquely_blocked": 14,
        "id": "FC-04",
        "match": {
          "depth": 1,
          "rail_class": "mandate-recurring"
        },
        "nominal_cardinality": 32,
        "reason": "A mandate must be created before it can be debited. Mandate-scope escalation and consent-fatigue abuse are both defined against a mandate object that a single-stage chain never created."
      },
      {
        "cells_matched": 24,
        "cells_uniquely_blocked": 14,
        "id": "FC-05",
        "match": {
          "locus": "delegated-agent-mandate",
          "rail_class": "card-post-auth"
        },
        "nominal_cardinality": 24,
        "reason": "There is no agent mandate object on the clearing and dispute rails in the canonical schema. A dispute is adjudicated between issuer, acquirer and network; the agent is not a party to the message."
      },
      {
        "cells_matched": 24,
        "cells_uniquely_blocked": 16,
        "id": "FC-06",
        "match": {
          "locus": "delegated-agent-mandate",
          "rail_class": "a2a-assisted"
        },
        "nominal_cardinality": 24,
        "reason": "The A2A/assisted class covers pacs.008-shaped credit transfers and AePS terminals. Neither carries an agent mandate or attestation object in this schema, so the locus has nothing to attach to."
      },
      {
        "cells_matched": 12,
        "cells_uniquely_blocked": 8,
        "id": "FC-08",
        "match": {
          "evasion": "low-visibility-rail",
          "rail_class": "card-token"
        },
        "nominal_cardinality": 12,
        "reason": "Token provisioning is one of the highest-visibility events in the card ecosystem: the network sees the provisioning request, the token requestor and the assurance level. Routing onto it is the opposite of moving to weaker visibility."
      },
      {
        "cells_matched": 12,
        "cells_uniquely_blocked": 6,
        "id": "FC-09",
        "match": {
          "evasion": "oracle-probing",
          "rail_class": "card-post-auth"
        },
        "nominal_cardinality": 12,
        "reason": "Clearing is a batch settlement channel with no per-attempt response to read. There is no oracle to probe: the feedback is a reconciliation file days later, which is the ATK-S family's opportunity but not a probing surface."
      },
      {
        "cells_matched": 48,
        "cells_uniquely_blocked": 21,
        "id": "FC-10",
        "match": {
          "depth": 1,
          "locus": "synthetic-identity"
        },
        "nominal_cardinality": 48,
        "reason": "A manufactured identity must be manufactured and onboarded before it can transact. The onboarding IS a stage, on every rail -- an application, an enrolment, a KYC or V-CIP session. A single-stage synthetic-identity chain would be an identity that transacted before it existed."
      },
      {
        "cells_matched": 48,
        "cells_uniquely_blocked": 14,
        "id": "FC-11",
        "match": {
          "depth": 1,
          "locus": "delegated-agent-mandate"
        },
        "nominal_cardinality": 48,
        "reason": "An agent mandate is delegated before it is exercised. A single-stage chain under a delegated mandate would be a debit with no mandate of record, which the G0 mandate-conformance guard rejects structurally rather than statistically."
      }
